{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "allowArbitraryExtensions": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./*"],
      "@mellowcad/engine": ["./cad/index.ts"],
      "@mellowcad/engine/locales/*": ["./cad/locales/*.ts"],
      "@mellowcad/react": ["./packages/react/src/index.ts"],
      "@mellowcad/editor": ["./packages/editor/src/index.ts"],
      "@mellowcad/editor/locales/*": ["./packages/editor/src/locales/*.ts"]
    }
  },
  "include": [
    "next-env.d.ts",
    "next.config.ts",
    "**/*.ts",
    "**/*.tsx",
    "**/*.mts",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "research",
    "cad/dist",
    "packages/*/dist",
    // Its React plugin is the example's own dependency, installed only where
    // `check:hosts` installs the example.
    "examples/*/vite.config.ts"
  ]
}
