{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "ignoreCommand": "sh scripts/vercel/ignore-build.sh",
  "functions": {
    "api/mcp.js": {
      "maxDuration": 5
    }
  },
  "routes": [
    {
      "src": "^/(?:(?:en|es|ar|pt-br|fr|it|de|ru|pl|cs|hu|ja|ko|zh-cn|zh-tw)/)?404/?$",
      "status": 404,
      "continue": true
    },
    {
      "handle": "error"
    },
    {
      "src": "^/(es|ar|pt-br|fr|it|de|ru|pl|cs|hu|ja|ko|zh-cn|zh-tw)(?:/.*)?$",
      "status": 404,
      "dest": "/$1/404"
    },
    {
      "src": "^/.*$",
      "status": 404,
      "dest": "/en/404"
    }
  ]
}
