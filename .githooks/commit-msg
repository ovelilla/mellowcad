#!/bin/sh
# Refuses a commit message that carries a Co-Authored-By trailer (AGENTS.md):
# GitHub lists its co-author as a contributor, and fifteen such commits of 1–3
# November 2026 had the history rewritten. Whatever tool writes the message.

if grep -qi '^co-authored-by:' "$1"; then
  echo "commit-msg: no Co-Authored-By trailer in this repository (AGENTS.md)." >&2
  exit 1
fi
