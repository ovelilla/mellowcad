#!/bin/sh
# Quality gate before every commit: the same checks CI runs.
#
# Enabled automatically by the `prepare` script (npm sets core.hooksPath here
# after install). To skip it for one commit: git commit --no-verify

set -e

echo "› typecheck"
npm run --silent typecheck

# The packages: only their builds enforce isolatedDeclarations, and publint,
# attw and the "use client" check read what the builds wrote. A package whose
# build is still to come has neither script (UNBUILT, test/packages.test.ts).
echo "› packages"
for package in cad packages/*; do
  for step in build check; do
    out=$(npm run --silent --if-present "$step" -w "$package" 2>&1) || { echo "$out"; exit 1; }
  done
done

echo "› lint"
npm run --silent lint

echo "› format"
npm run --silent format:check

# With coverage: CI fails on vitest.config.ts's thresholds, and a plain
# `npm test` let nine commits through that CI then rejected.
echo "› test"
npm run --silent test:coverage

echo "✓ ready to commit"
