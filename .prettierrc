{
  "endOfLine": "lf",
  "semi": false,
  "singleQuote": false,
  "tabWidth": 2,
  "trailingComma": "es5",
  "printWidth": 80,
  "plugins": ["prettier-plugin-tailwindcss"],
  "tailwindStylesheet": "app/[locale]/(app)/globals.css",
  "tailwindFunctions": ["cn", "cva"],
  "overrides": [
    {
      "files": [
        "app/*/*marketing*/**",
        "app/global-not-found.tsx",
        "components/marketing/**"
      ],
      "options": {
        "tailwindStylesheet": "app/[locale]/(marketing)/marketing.css"
      }
    }
  ]
}
