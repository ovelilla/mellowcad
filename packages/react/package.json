{
  "name": "@mellowcad/react",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown",
    "check": "publint --strict && attw --pack . --profile esm-only && node ../../scripts/packages/client-directive.ts",
    "check:hosts": "node ../../scripts/packages/hosts.ts",
    "prepublishOnly": "npm run check:hosts"
  },
  "peerDependencies": {
    "@mellowcad/engine": "^0.0.0",
    "react": "^19.0.0"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "publint": "^0.3.25",
    "tsdown": "^0.23.2"
  }
}
