{
  "name": "@mellowcad/react",
  "version": "0.1.0",
  "description": "React bindings for @mellowcad/engine: the drawing canvas with its engine, the engine state as React state, and the wiring of the fields AutoCAD users type into.",
  "keywords": [
    "cad",
    "2d",
    "drafting",
    "autocad",
    "react",
    "canvas",
    "hooks"
  ],
  "homepage": "https://mellowcad.com/docs/react",
  "bugs": "https://github.com/ovelilla/mellowcad/issues",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ovelilla/mellowcad.git",
    "directory": "packages/react"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown",
    "check": "publint --strict && attw --pack . --profile esm-only && node ../../scripts/packages/client-directive.ts",
    "check:hosts": "node ../../scripts/packages/hosts.ts",
    "prepublishOnly": "npm run check:hosts"
  },
  "peerDependencies": {
    "@mellowcad/engine": "^0.2.0",
    "react": "^19.0.0"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "publint": "^0.3.25",
    "tsdown": "^0.23.2"
  }
}
