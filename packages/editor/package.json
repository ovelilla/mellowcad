{
  "name": "@mellowcad/editor",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./locales/en": {
      "types": "./dist/locales/en.d.ts",
      "default": "./dist/locales/en.js"
    },
    "./locales/es": {
      "types": "./dist/locales/es.d.ts",
      "default": "./dist/locales/es.js"
    },
    "./locales/ar": {
      "types": "./dist/locales/ar.d.ts",
      "default": "./dist/locales/ar.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown",
    "check": "publint --strict && attw --pack . --profile esm-only && node ../../scripts/packages/client-directive.ts --compiled"
  },
  "peerDependencies": {
    "@mellowcad/engine": "^0.0.0",
    "@mellowcad/react": "^0.0.0",
    "react": "^19.0.0"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "icu-minify": "^4.14.9",
    "lucide-react": "^1.59.0",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@babel/core": "^7.29.7",
    "@rolldown/plugin-babel": "^0.2.4",
    "babel-plugin-react-compiler": "^1.0.0",
    "publint": "^0.3.25",
    "tsdown": "^0.23.2"
  }
}
