{
  "name": "@mellowcad/editor",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./locales/en": {
      "types": "./dist/locales/en.d.ts",
      "default": "./dist/locales/en.js"
    },
    "./locales/es": {
      "types": "./dist/locales/es.d.ts",
      "default": "./dist/locales/es.js"
    },
    "./locales/ar": {
      "types": "./dist/locales/ar.d.ts",
      "default": "./dist/locales/ar.js"
    },
    "./styles.css": "./dist/styles.css",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown && node ../../scripts/editor/styles.ts",
    "check": "publint --strict && attw --pack . --profile esm-only --exclude-entrypoints ./styles.css && node ../../scripts/packages/client-directive.ts --compiled && node ../../scripts/editor/styles.ts --check",
    "check:hosts": "node ../../scripts/packages/hosts.ts",
    "prepublishOnly": "npm run check:hosts"
  },
  "peerDependencies": {
    "@mellowcad/engine": "^0.0.0",
    "@mellowcad/react": "^0.0.0",
    "react": "^19.0.0"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "icu-minify": "^4.14.9",
    "lucide-react": "^1.59.0",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@babel/core": "^7.29.7",
    "@rolldown/plugin-babel": "^0.2.4",
    "@tailwindcss/node": "^4.3.3",
    "@tailwindcss/postcss": "^4.3.3",
    "babel-plugin-react-compiler": "^1.0.0",
    "postcss": "^8.5.30",
    "postcss-selector-parser": "^7.1.6",
    "publint": "^0.3.25",
    "shadcn": "^4.22.0",
    "tailwindcss": "^4.3.3",
    "tsdown": "^0.23.2",
    "tw-animate-css": "^1.4.0"
  }
}
