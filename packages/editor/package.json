      "default": "./dist/locales/ar.js"
    },
    "./package.json": "./package.json"
  },
  "peerDependencies": {
    "@mellowcad/engine": "^0.0.0",
    "@mellowcad/react": "^0.0.0",
    "react": "^19.0.0"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "icu-minify": "^4.14.9",
    "lucide-react": "^1.59.0",
    "tailwind-merge": "^3.7.0"
