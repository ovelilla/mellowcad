{
  "name": "@mellowcad/editor",
  "version": "0.1.0",
  "description": "The MellowCAD drafting editor as one React component: the canvas with AutoCAD-style chrome, menus and dialogs, its stylesheet and its words in four languages.",
  "keywords": [
    "cad",
    "2d",
    "3d",
    "drafting",
    "autocad",
    "react",
    "editor",
    "component"
  ],
  "homepage": "https://mellowcad.com/docs/editor",
  "bugs": "https://github.com/ovelilla/mellowcad/issues",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ovelilla/mellowcad.git",
    "directory": "packages/editor"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./locales/en": {
      "types": "./dist/locales/en.d.ts",
      "default": "./dist/locales/en.js"
    },
    "./locales/es": {
      "types": "./dist/locales/es.d.ts",
      "default": "./dist/locales/es.js"
    },
    "./locales/ar": {
      "types": "./dist/locales/ar.d.ts",
      "default": "./dist/locales/ar.js"
    },
    "./locales/pt-BR": {
      "types": "./dist/locales/pt-BR.d.ts",
      "default": "./dist/locales/pt-BR.js"
    },
    "./locales/fr": {
      "types": "./dist/locales/fr.d.ts",
      "default": "./dist/locales/fr.js"
    },
    "./styles.css": "./dist/styles.css",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown && node ../../scripts/editor/styles.ts",
    "check": "publint --strict && attw --pack . --profile esm-only --exclude-entrypoints ./styles.css && node ../../scripts/packages/client-directive.ts --compiled && node ../../scripts/editor/styles.ts --check",
    "check:hosts": "node ../../scripts/packages/hosts.ts",
    "prepublishOnly": "npm run check:hosts"
  },
  "peerDependencies": {
    "@mellowcad/engine": "^0.2.0",
    "@mellowcad/react": "^0.1.0",
    "react": "^19.0.0"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.2",
    "icu-minify": "^4.14.9",
    "lucide-react": "^1.67.0"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@babel/core": "^7.29.7",
    "@rolldown/plugin-babel": "^0.3.0",
    "@tailwindcss/node": "^4.3.4",
    "@tailwindcss/postcss": "^4.3.4",
    "babel-plugin-react-compiler": "^1.0.0",
    "postcss": "^8.5.32",
    "postcss-selector-parser": "^7.1.7",
    "publint": "^0.3.25",
    "shadcn": "^4.23.0",
    "tailwindcss": "^4.3.4",
    "tsdown": "^0.23.4",
    "tw-animate-css": "^1.4.0"
  }
}
