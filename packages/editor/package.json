{
  "name": "@mellowcad/editor",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./locales/en": {
      "types": "./dist/locales/en.d.ts",
      "default": "./dist/locales/en.js"
    },
    "./locales/es": {
      "types": "./dist/locales/es.d.ts",
      "default": "./dist/locales/es.js"
