{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["es2023", "dom", "dom.iterable"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "allowArbitraryExtensions": true,
    "declaration": true,
    "isolatedDeclarations": true,
    "stripInternal": true,
    "noEmit": false,
    "emitDeclarationOnly": true,
    "types": []
  },
  "include": [
    "src/index.ts",
    "src/locales/en.ts",
    "src/locales/es.ts",
    "src/locales/ar.ts"
  ]
}
