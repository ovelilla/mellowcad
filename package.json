{
  "name": "mellowcad",
  "version": "0.1.0",
  "license": "MIT",
  "type": "module",
  "private": true,
  "workspaces": [
    "cad",
    "packages/*"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "prepare": "git config core.hooksPath .githooks || exit 0",
    "lint": "eslint",
    "format": "prettier --write \"**/*.{ts,tsx}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx}\"",
    "typecheck": "next typegen && tsc --noEmit --incremental false",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "knowledge": "KNOWLEDGE_STATS=1 vitest run test/knowledge.test.ts --reporter=verbose",
    "docs:check": "node scripts/docs/check.ts",
    "locales": "node scripts/locales/compile.ts && node scripts/locales/editor.ts",
    "version-packages": "changeset version && node scripts/packages/examples.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "bidi-js": "^1.1.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "fumadocs-core": "^16.17.8",
    "fumadocs-mdx": "^15.4.10",
    "icu-minify": "^4.14.9",
    "lucide-react": "^1.59.0",
    "next": "16.4.2",
    "next-intl": "^4.14.9",
    "opentype.js": "^2.0.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "shiki": "^4.5.0",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@formatjs/icu-messageformat-parser": "^3.5.21",
    "@tailwindcss/postcss": "^4",
    "@types/mdx": "^2.0.14",
    "@types/node": "^24.19.2",
    "@types/opentype.js": "^1.3.10",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/coverage-v8": "^4.1.12",
    "babel-plugin-react-compiler": "^1.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "fast-check": "^4.10.2",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "schema-dts": "^2.1.0",
    "shadcn": "^4.22.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.12"
  },
  "allowScripts": {
    "@parcel/watcher": false,
    "@swc/core": false,
    "esbuild": false,
    "unrs-resolver": false
  }
}
