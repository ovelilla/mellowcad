{
  "name": "mellowcad",
  "version": "0.1.0",
  "license": "MIT",
  "type": "module",
  "private": true,
  "workspaces": [
    "cad",
    "packages/*"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "engines": {
    "node": "26.x"
  },
  "scripts": {
    "dev": "NEXT_TELEMETRY_DISABLED=1 next dev",
    "build": "next build",
    "start": "next start",
    "prepare": "git config core.hooksPath .githooks || exit 0",
    "lint": "eslint",
    "format": "prettier --write \"**/*.{ts,tsx}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx}\"",
    "typecheck": "next typegen && tsc --noEmit --incremental false",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "knowledge": "KNOWLEDGE_STATS=1 vitest run test/knowledge.test.ts --reporter=verbose",
    "knowledge:loads": "node scripts/knowledge/loads.mjs",
    "docs:check": "node scripts/docs/check.ts",
    "locales": "node scripts/locales/compile.ts && node scripts/locales/editor.ts && node scripts/locales/sources.ts",
    "version-packages": "changeset version && node scripts/packages/examples.ts",
    "deps:check": "node scripts/deps/check.ts",
    "indexnow": "node scripts/seo/indexnow.ts",
    "cloudflare": "node scripts/cloudflare/zone.ts",
    "vercel": "VERCEL_ORG_ID=team_GanZPj63t8Id5tzLIyVHAOAB VERCEL_PROJECT_ID=prj_Ndy0vHinNbua4fquSINCByg1Paj4 VERCEL_TOKEN=$MELLOWCAD_VERCEL_TOKEN vercel"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@modelcontextprotocol/server": "^2.4.0",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.1.0",
    "bidi-js": "^1.1.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.2",
    "fumadocs-core": "^16.18.4",
    "fumadocs-mdx": "^15.5.3",
    "icu-minify": "^4.14.9",
    "lucide-react": "^1.74.0",
    "mcp-handler": "^2.4.0",
    "next": "16.4.6",
    "next-intl": "^4.14.9",
    "opentype.js": "^2.0.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "shiki": "^4.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@formatjs/icu-messageformat-parser": "^3.5.23",
    "@tailwindcss/postcss": "^4.3.5",
    "@types/mdx": "^2.0.14",
    "@types/node": "^26.6.6",
    "@types/opentype.js": "^1.3.10",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/coverage-v8": "^5.1.0",
    "babel-plugin-react-compiler": "^1.0.0",
    "eslint": "^10.15.0",
    "eslint-config-next": "16.4.6",
    "fast-check": "^4.10.2",
    "prettier": "^3.10.1",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "schema-dts": "^2.1.0",
    "shadcn": "^4.23.0",
    "tailwindcss": "^4.3.5",
    "typescript": "^6.0.3",
    "vitest": "^5.1.0",
    "yaml": "^2.9.1"
  },
  "allowScripts": {
    "@parcel/watcher": false,
    "@swc/core": false,
    "esbuild": false,
    "unrs-resolver": false
  }
}
