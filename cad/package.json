{
  "name": "@mellowcad/engine",
  "version": "0.1.1",
  "description": "A 2D CAD drafting engine that works like AutoCAD: its commands, aliases, prompts, keywords and object snaps, headless or on a canvas.",
  "keywords": [
    "cad",
    "2d",
    "drafting",
    "drawing",
    "autocad",
    "canvas",
    "engine",
    "headless"
  ],
  "homepage": "https://mellowcad.com/docs/engine",
  "bugs": "https://github.com/ovelilla/mellowcad/issues",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ovelilla/mellowcad.git",
    "directory": "cad"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./locales/en": {
      "types": "./dist/locales/en.d.ts",
      "default": "./dist/locales/en.js"
    },
    "./locales/es": {
      "types": "./dist/locales/es.d.ts",
      "default": "./dist/locales/es.js"
    },
    "./locales/ar": {
      "types": "./dist/locales/ar.d.ts",
      "default": "./dist/locales/ar.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown",
    "check": "publint --strict && attw --pack . --profile esm-only",
    "check:hosts": "node ../scripts/packages/hosts.ts",
    "prepublishOnly": "npm run check:hosts"
  },
  "dependencies": {
    "icu-minify": "^4.14.9"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "publint": "^0.3.25",
    "tsdown": "^0.23.2"
  }
}
