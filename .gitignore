# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build
/cad/dist/
/packages/*/dist/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
/.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# AutoCAD's string tables: Autodesk's text, kept beside the project, never in git
# (no trailing slash: a session's worktree links it, .claude/hooks/worktree-create.mjs)
/research
.vercel

# next-intl types every message from messages/en.json (regenerated by `next typegen`)
messages/*.d.json.ts

# The examples' installs and builds, when one is run in place
/examples/*/node_modules/
/examples/*/dist/
/examples/*/.next/
/examples/*/*.ecad.json
/examples/*/drawing.svg

# Sessions' own checkouts (.claude/hooks/worktree-create.mjs); the folder is kept so
# that citing it holds in every checkout.
/.claude/worktrees/*
!/.claude/worktrees/.gitkeep

# What the InstructionsLoaded hook logs (.claude/hooks/instructions-log.mjs)
/.claude/logs/
